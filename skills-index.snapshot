_v0.3.md","okf_type":"Documentation","title":"CCDD — Especificación v0.3"}},{"id":"ccdd_spec_v0.3.md#81","metadata":{"content":"no vive fuera del gate (§5.5).","okf_concept":"ccdd_spec_v0.3.md","okf_type":"Documentation","title":"CCDD — Especificación v0.3"}},{"id":"ccdd_spec_v0.3.md#82","metadata":{"content":"o vive fuera del gate (§5.5).","okf_concept":"ccdd_spec_v0.3.md","okf_type":"Documentation","title":"CCDD — Especificación v0.3"}},{"id":"ccdd_spec_v0.3.md#83","metadata":{"content":"vive fuera del gate (§5.5).","okf_concept":"ccdd_spec_v0.3.md","okf_type":"Documentation","title":"CCDD — Especificación v0.3"}},{"id":"ccdd_spec_v0.3.md#84","metadata":{"content":"vive fuera del gate (§5.5).","okf_concept":"ccdd_spec_v0.3.md","okf_type":"Documentation","title":"CCDD — Especificación v0.3"}},{"id":"ccdd_spec_v0.3.md#85","metadata":{"content":"ive fuera del gate (§5.5).","okf_concept":"ccdd_spec_v0.3.md","okf_type":"Documentation","title":"CCDD — Especificación v0.3"}},{"id":"ccdd_spec_v0.3.md#86","metadata":{"content":"ve fuera del gate (§5.5).","okf_concept":"ccdd_spec_v0.3.md","okf_type":"Documentation","title":"CCDD — Especificación v0.3"}},{"id":"ccdd_spec_v0.3.md#87","metadata":{"content":"e fuera del gate (§5.5).","okf_concept":"ccdd_spec_v0.3.md","okf_type":"Documentation","title":"CCDD — Especificación v0.3"}},{"id":"ccdd_spec_v0.3.md#88","metadata":{"content":"fuera del gate (§5.5).","okf_concept":"ccdd_spec_v0.3.md","okf_type":"Documentation","title":"CCDD — Especificación v0.3"}},{"id":"ccdd_spec_v0.3.md#89","metadata":{"content":"fuera del gate (§5.5).","okf_concept":"ccdd_spec_v0.3.md","okf_type":"Documentation","title":"CCDD — Especificación v0.3"}},{"id":"ccdd_spec_v0.3.md#9","metadata":{"content":"e estos vectores.\n\n---\n\n## 2. Terminología","okf_concept":"ccdd_spec_v0.3.md","okf_type":"Documentation","title":"CCDD — Especificación v0.3"}},{"id":"ccdd_spec_v0.3.md#90","metadata":{"content":"uera del gate (§5.5).","okf_concept":"ccdd_spec_v0.3.md","okf_type":"Documentation","title":"CCDD — Especificación v0.3"}},{"id":"ccdd_spec_v0.3.md#91","metadata":{"content":"era del gate (§5.5).","okf_concept":"ccdd_spec_v0.3.md","okf_type":"Documentation","title":"CCDD — Especificación v0.3"}},{"id":"ccdd_spec_v0.3.md#92","metadata":{"content":"ra del gate (§5.5).","okf_concept":"ccdd_spec_v0.3.md","okf_type":"Documentation","title":"CCDD — Especificación v0.3"}},{"id":"ccdd_spec_v0.3.md#93","metadata":{"content":"a del gate (§5.5).","okf_concept":"ccdd_spec_v0.3.md","okf_type":"Documentation","title":"CCDD — Especificación v0.3"}},{"id":"ccdd_spec_v0.3.md#94","metadata":{"content":"del gate (§5.5).","okf_concept":"ccdd_spec_v0.3.md","okf_type":"Documentation","title":"CCDD — Especificación v0.3"}},{"id":"ccdd_spec_v0.3.md#95","metadata":{"content":"del gate (§5.5).","okf_concept":"ccdd_spec_v0.3.md","okf_type":"Documentation","title":"CCDD — Especificación v0.3"}},{"id":"ccdd_spec_v0.3.md#96","metadata":{"content":"el gate (§5.5).","okf_concept":"ccdd_spec_v0.3.md","okf_type":"Documentation","title":"CCDD — Especificación v0.3"}},{"id":"ccdd_spec_v0.3.md#97","metadata":{"content":"l gate (§5.5).","okf_concept":"ccdd_spec_v0.3.md","okf_type":"Documentation","title":"CCDD — Especificación v0.3"}},{"id":"ccdd_spec_v0.3.md#98","metadata":{"content":"gate (§5.5).","okf_concept":"ccdd_spec_v0.3.md","okf_type":"Documentation","title":"CCDD — Especificación v0.3"}},{"id":"ccdd_spec_v0.3.md#99","metadata":{"content":"gate (§5.5).","okf_concept":"ccdd_spec_v0.3.md","okf_type":"Documentation","title":"CCDD — Especificación v0.3"}},{"id":"ccdd_workflow.md#0","metadata":{"content":"# Context Contract-Driven Development (CCDD)\n## Una Metodología para Sistemas de Agentes y LLMs Confiables\n\n> **Documento de motivación (manifiesto).** La especificación normativa —terminología, requisitos MUST/SHOULD, niveles de conformidad y consideraciones de seguridad— vive en `ccdd_spec_v0.3.md`, con esquema formal (`ccdd_context.schema.json`) e implementación de referencia (`ccdd_reference/`). En caso de conflicto, manda la especificación.\n\n---\n\n## 🎯 Propósito\n\nCCDD nace de una pregunta concreta sobre la **cocreación humano–IA**:\n\n> ¿Cómo le delego una tarea a una IA y tengo un grado de confianza alto de que no solo la **ejecutará**, sino que **verificará su propio trabajo** y **evitará alucinar** en lo posible?","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#1","metadata":{"content":"trabajo** y **evitará alucinar** en lo posible?\n\nLa distancia entre *\"ejecutar\"* y *\"ejecutar-verificando\"* es la que separa una IA en la que hay que revisar todo a mano de una a la que se le puede **delegar con confianza**. CCDD existe para habilitar esa segunda.\n\nEl **contrato de contexto híbrido** es el instrumento de esa confianza:\n\n- **Lo verificable** (estructura, presupuestos, firmas, reglas) lo chequea una máquina, de forma determinista y reproducible → el humano no tiene que *creer*, puede *comprobar*.\n- **Lo opinable** (juicio, criterio, comportamiento) queda marcado explícitamente como tal, **fuera** del control automático → ahí el humano mantiene el ojo, y la IA *informa pero no decide*.","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#10","metadata":{"content":"o `expected-hashes.json` en el repositorio Git.","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#100","metadata":{"content":"tiva de Metodologías","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#101","metadata":{"content":"iva de Metodologías","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#102","metadata":{"content":"va de Metodologías","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#103","metadata":{"content":"a de Metodologías","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#104","metadata":{"content":"de Metodologías","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#105","metadata":{"content":"de Metodologías","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#106","metadata":{"content":"e Metodologías","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#107","metadata":{"content":"Metodologías","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#108","metadata":{"content":"Metodologías","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#109","metadata":{"content":"etodologías","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#11","metadata":{"content":"`expected-hashes.json` en el repositorio Git.","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#110","metadata":{"content":"todologías","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#111","metadata":{"content":"odologías","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#112","metadata":{"content":"dologías","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#113","metadata":{"content":"ologías","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#114","metadata":{"content":"logías","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#115","metadata":{"content":"ogías","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#116","metadata":{"content":"gías","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#117","metadata":{"content":"ías","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#118","metadata":{"content":"as","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#119","metadata":{"content":"s","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#12","metadata":{"content":"`expected-hashes.json` en el repositorio Git.","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#120","metadata":{"content":"| Dimensión | SDD (Specification-Driven) | TDD (Test-Driven) | CCDD (Context Contract-Driven) |\n| :--- | :--- | :--- | :--- |\n| **Naturaleza del control** | 100% determinista | 100% determinista | **Híbrida**: parte determinista (se verifica) + parte probabilística (se juzga) |\n| **Sistema que gobierna** | Determinista (código). | Determinista (funciones). | **No-determinista** (LLM / agentes). |\n| **Foco Principal** | Estructuras de datos y firma de métodos. | Comportamiento esperado de funciones puras. | Calidad de la señal de entrada en sistemas probabilísticos. |\n| **Artefacto Clave** | Schema (OpenAPI, GraphQL, Protobuf). | Casos de Prueba (Jest, PyTest, JUnit). | Contrato de Contexto híbrido (`context.yaml`).","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#121","metadata":{"content":"| Contrato de Contexto híbrido (`context.yaml`). |\n| **Garantía en CI** | Compilación exitosa, validación de tipos. | Porcentaje de cobertura de código (Coverage). | Ausencia de regresiones de políticas y drift de prompts. |\n| **Manejo de Fallos** | Excepciones estructuradas en runtime. | Tests rojos que bloquean despliegue. | Truncamiento controlado por prioridad y guardrails pre-inferencia. |\n\n---\n\n## 📈 Beneficios Clave del Flujo CCDD","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#122","metadata":{"content":"|\n\n---\n\n## 📈 Beneficios Clave del Flujo CCDD","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#123","metadata":{"content":"|\n\n---\n\n## 📈 Beneficios Clave del Flujo CCDD","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#124","metadata":{"content":"---\n\n## 📈 Beneficios Clave del Flujo CCDD","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#125","metadata":{"content":"---\n\n## 📈 Beneficios Clave del Flujo CCDD","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#126","metadata":{"content":"---\n\n## 📈 Beneficios Clave del Flujo CCDD","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#127","metadata":{"content":"--\n\n## 📈 Beneficios Clave del Flujo CCDD","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#128","metadata":{"content":"-\n\n## 📈 Beneficios Clave del Flujo CCDD","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#129","metadata":{"content":"## 📈 Beneficios Clave del Flujo CCDD","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#13","metadata":{"content":"expected-hashes.json` en el repositorio Git.","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#130","metadata":{"content":"## 📈 Beneficios Clave del Flujo CCDD","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#131","metadata":{"content":"## 📈 Beneficios Clave del Flujo CCDD","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#132","metadata":{"content":"# 📈 Beneficios Clave del Flujo CCDD","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#133","metadata":{"content":"📈 Beneficios Clave del Flujo CCDD","okf_concept":"ccdd_workflow.md","okf_type":"Documentation","title":"Context Contract-Driven Development (CCDD)"}},{"id":"ccdd_workflow.md#134","metadata":{"content":"📈 Beneficios Clave del Flujo CCDD","okf_concept":"ccdd_workflow.md","okf_type":"Documentation",